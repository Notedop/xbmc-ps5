diff --git a/src/Stream.cpp b/src/Stream.cpp
index 6977522..03e75c9 100644
--- a/src/Stream.cpp
+++ b/src/Stream.cpp
@@ -16,20 +16,31 @@ using namespace SESSION;
 
 void CStream::Disable()
 {
+  LOG::PS5StopPhase("disable-enter", this);
   m_adStream.Disable();
   // Stop method stop the downloads, but not the reader.
   m_adStream.Stop();
+  LOG::PS5StopPhase("downloads-stopped", this);
   // The reader is an async thread and may still working to read buffer data,
   // so wait for it to exit before the AdaptiveStream::Dispose call,
   // otherwise it will cause data access violation on buffers because still in use
   if (m_streamReader)
+  {
+    LOG::PS5StopPhase("reader-wait-enter", this);
     m_streamReader->WaitReadSampleAsyncComplete();
+    LOG::PS5StopPhase("reader-wait-exit", this);
+  }
 
+  LOG::PS5StopPhase("dispose-enter", this);
   m_adStream.Dispose();
+  LOG::PS5StopPhase("dispose-exit", this);
 
+  LOG::PS5StopPhase("reader-reset-enter", this);
   Reset();
+  LOG::PS5StopPhase("reader-reset-exit", this);
 
   m_isEnabled = false;
+  LOG::PS5StopPhase("disable-exit", this);
 }
 
 void CStream::Reset()
