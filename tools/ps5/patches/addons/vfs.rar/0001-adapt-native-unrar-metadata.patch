Omit unsupported Unix metadata restoration in native PS5 Unrar.

PS5 cannot resolve archived Unix groups. Guard ownership restoration,
not Unix file handling or archive parsing. Disable the existing optional
USE_LUTIMES feature because native libc cannot timestamp symlinks; retain
symlink extraction, safety checks and normal file timestamps. Kodi's RAR
VFS needs file contents, not restoration of another host's owner IDs.

Upstream: PS5 native libc capability adaptation only.

--- a/lib/UnrarXLib/CMakeLists.txt
+++ b/lib/UnrarXLib/CMakeLists.txt
@@ -52,6 +52,10 @@
 
 add_library(unrarxlib STATIC ${SOURCES})
 set_property(TARGET unrarxlib PROPERTY POSITION_INDEPENDENT_CODE ON)
+if(PS5_NATIVE_SHARED_ADDONS)
+  target_compile_definitions(unrarxlib PRIVATE RAR_NO_UNIX_OWNERS RAR_NO_LUTIMES)
+endif()
+
 if(NOT CORE_SYSTEM_NAME MATCHES windows)
   target_compile_definitions(unrarxlib PRIVATE -DSILENT -DRARDLL)
 else()
