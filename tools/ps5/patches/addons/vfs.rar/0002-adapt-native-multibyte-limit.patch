Bridge Unrar's FreeBSD multibyte-limit accessor to native libc data.

The SDK stdlib header declares ___mb_cur_max(), but native libc exports
the __mb_cur_max integer instead. Read the native value rather than
assuming a fixed locale or changing Unrar's filename conversion behavior.
Keep this adapter local to the add-on; no runtime provider change is needed.

Upstream: PS5 native libc ABI adaptation only.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -41,4 +41,11 @@
 
 build_addon(vfs.rar RAR DEPLIBS)
 
+if(PS5_NATIVE_SHARED_ADDONS)
+  set(_multibyte_adapter "${CMAKE_CURRENT_BINARY_DIR}/ps5-multibyte-limit.c")
+  file(WRITE "${_multibyte_adapter}"
+    "#include <stdlib.h>\nint ___mb_cur_max(void) { return __mb_cur_max; }\n")
+  target_sources(vfs.rar PRIVATE "${_multibyte_adapter}")
+endif()
+
 include(CPack)
