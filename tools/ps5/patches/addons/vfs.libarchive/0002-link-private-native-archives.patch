+  set(LibArchive_INCLUDE_DIR "${_private_prefix}/include" CACHE PATH "" FORCE)
+  set(LibArchive_LIBRARY "${_private_prefix}/lib/libarchive.a" CACHE FILEPATH "" FORCE)
