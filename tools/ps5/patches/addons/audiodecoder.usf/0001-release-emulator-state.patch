   if (psf_load(filename.c_str(), &psf_file_system, 0x21, usf_load, ctx.state, psf_info_meta, &ctx,
                0, nullptr, nullptr) < 0)
   {
-    delete ctx.state;
+    ReleaseState();
     return false;
   }
   totaltime = ctx.len;
@@ -214,8 +227,12 @@
