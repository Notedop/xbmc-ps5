Link the three Nosefart engines statically with separate symbol namespaces.

The native build otherwise installs three ordinary ELF .so helpers which cannot
be loaded by the PS5 native loader. Keep the upstream tag engine and two playback
engines isolated: sharing one copy would merge the emulator's global state.
Upstream: PS5-only; avoids dlopen without changing the engine selection policy.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -20,4 +20,1 @@
-add_definitions(-DLIBRARY_PREFIX="${CMAKE_SHARED_LIBRARY_PREFIX}"
-                -DLIBRARY_SUFFIX="${CMAKE_SHARED_LIBRARY_SUFFIX}")
-
-set(NOSEFART_ADDITIONAL_BINARY $<TARGET_FILE:nosefart_tag> $<TARGET_FILE:nosefart_0> $<TARGET_FILE:nosefart_1>)
+set(DEPLIBS nosefart_tag nosefart_0 nosefart_1)
--- a/lib/nosefart/CMakeLists.txt
+++ b/lib/nosefart/CMakeLists.txt
@@ -22,8 +22,24 @@
-add_library(nosefart_tag SHARED ${SOURCES})
-add_library(nosefart_0 SHARED ${SOURCES})
-add_library(nosefart_1 SHARED ${SOURCES})
-if(NOT WIN32)
-  target_link_libraries(nosefart_tag m)
-  target_link_libraries(nosefart_0 m)
-  target_link_libraries(nosefart_1 m)
-endif()
+set(NOSEFART_GLOBALS
+    OPLCreate OPLDestroy OPLRead OPLResetChip OPLSetIRQHandler OPLSetTimerHandler
+    OPLSetUpdateHandler OPLTimerOver OPLWrite YM3812UpdateOne
+    SLOT7_1 SLOT7_2 SLOT8_1 SLOT8_2 _my_free _my_malloc acc_nes6502_banks ams_table
+    apu_build_luts apu_create apu_destroy apu_getcontext apu_getcyclerate
+    apu_getpcmdata apu_process apu_read apu_reset apu_setchan apu_setcontext
+    apu_setext apu_setfilter apu_write dmc_clocks fds_ext
+    log_init log_print log_printf log_shutdown max_access mem_checkblocks
+    mem_checkleaks mem_debug mmc5_ext nes6502_chk_mem_access nes6502_execute
+    nes6502_getbyte nes6502_getcontext nes6502_getcycles nes6502_init nes6502_irq
+    nes6502_mem_access nes6502_nmi nes6502_reset nes6502_setcontext nes6502_setdma
+    nes_shutdown nsf_frame nsf_free nsf_init nsf_load nsf_load_extended
+    nsf_nes6502_mem_access nsf_playtrack nsf_setchan nsf_setfilter
+    table vib_table vrc7_ext vrcvi_ext)
+
+foreach(engine IN ITEMS nosefart_tag nosefart_0 nosefart_1)
+  add_library(${engine} STATIC ${SOURCES})
+  foreach(symbol IN LISTS NOSEFART_GLOBALS)
+    target_compile_definitions(${engine} PRIVATE "${symbol}=${engine}_${symbol}")
+  endforeach()
+  if(NOT WIN32)
+    target_link_libraries(${engine} m)
+  endif()
+endforeach()
