Subject: Use private matching OpenSSL archives and writable PS5 SSH storage

The SDK's core crypto provider differs from the add-on's pinned OpenSSL;
libssh and libssl must use this recipe's matching private libcrypto archive.
PS5 has no desktop SSH home; use Kodi's writable home for keys and knownhosts.
Upstream: PS5-only library selection and platform home directory extension.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -4,6 +4,13 @@
 list(APPEND CMAKE_MODULE_PATH ${PROJECT_SOURCE_DIR})
 
 find_package(Kodi REQUIRED)
+if(CORE_PLATFORM_NAME STREQUAL "ps5")
+  set(OPENSSL_USE_STATIC_LIBS ON)
+  set(OPENSSL_ROOT_DIR "${ADDON_DEPENDS_PATH}")
+  set(OPENSSL_INCLUDE_DIR "${ADDON_DEPENDS_PATH}/include" CACHE PATH "" FORCE)
+  set(OPENSSL_SSL_LIBRARY "${ADDON_DEPENDS_PATH}/lib/libssl.a" CACHE FILEPATH "" FORCE)
+  set(OPENSSL_CRYPTO_LIBRARY "${ADDON_DEPENDS_PATH}/lib/libcrypto.a" CACHE FILEPATH "" FORCE)
+endif()
 find_package(OpenSSL REQUIRED)
 find_package(SSH REQUIRED)
 find_package(ZLIB REQUIRED)
--- a/src/SFTPSession.cpp
+++ b/src/SFTPSession.cpp
@@ -137,4 +137,4 @@
-#if defined(TARGET_DARWIN_IOS) || defined(TARGET_WINDOWS_STORE)
+#if defined(TARGET_DARWIN_IOS) || defined(TARGET_WINDOWS_STORE) || defined(TARGET_PS5)
   std::string sshFolder = kodi::vfs::TranslateSpecialProtocol("special://home/.ssh");
   if (ssh_options_set(m_session, SSH_OPTIONS_SSH_DIR, sshFolder.c_str()) < 0)
   {
