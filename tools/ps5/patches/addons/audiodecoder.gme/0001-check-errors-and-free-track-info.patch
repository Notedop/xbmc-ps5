     return false;
 
-  gme_info_t* out;
-  gme_track_info(gme, &out, track > 0 ? track - 1 : 0);
+  gme_info_t* out = nullptr;
+  if (gme_track_info(gme, &out, track > 0 ? track - 1 : 0) || !out)
+  {
