#!/usr/bin/env bash
set -e
. "$(dirname "$0")/environment"
echo "Running host PS5 build-tool regressions; PS5 target/runtime tests are not run."
if [ "$#" = 0 ]; then
  set -- test-buildsteps.py test-check-package-build.py test-package-deploy.py \
    test-package-inputs.py test-package-metadata.py test-package-stage.py test-kodi-link-inputs.py \
    test-native-graphics.py test-prepare-native-runtime.py test-python-discovery.py \
    test-opengl-bootstrap.py test-bootstrap-sdk.py test-pacbrew-bootstrap.py test-test-runner.py
fi
mkdir -p "$WORKSPACE/build"
TEST_TMP="$WORKSPACE/build/ps5-host-tests-$$"
mkdir "$TEST_TMP"
trap 'rm -rf -- "$TEST_TMP"' EXIT
export TMPDIR="$TEST_TMP"
export PYTHONDONTWRITEBYTECODE=1
python3 "$WORKSPACE/tools/ps5/tests/run.py" "$@"
