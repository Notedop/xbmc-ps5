Pass the C and linker flags to the sidplay2 configure step.

CMAKE_CXX_FLAGS selects the --target=x86_64-unknown-freebsd driver, which
needs the matching toolchain link flags; without them configure links with the
host linker and startfiles. Pass the C and linker flags from the toolchain too.

Upstream: cross-compile fix, suitable for xbmc/audiodecoder.sidplay.

--- a/depends/common/sidplay2/CMakeLists.txt
+++ b/depends/common/sidplay2/CMakeLists.txt
@@ -11,7 +11,9 @@
                                    autoreconf -vif builders/hardsid-builder &&
                                    autoreconf -vif libsidutils
                     CONFIGURE_COMMAND ${CMAKE_COMMAND} -E env
+                      "CFLAGS=${CMAKE_C_FLAGS}"
                       "CXXFLAGS=${CMAKE_CXX_FLAGS} -DHAVE_UNIX"
+                      "LDFLAGS=${CMAKE_EXE_LINKER_FLAGS}"
                       <SOURCE_DIR>/configure
                       --prefix=${OUTPUT_DIR}
                       --disable-shared
