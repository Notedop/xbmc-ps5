Check libgme errors and free track info.

gme_track_info() allocates a gme_info_t that must be released with
gme_free_info(); Init() and ReadTag() never freed it, leaking one per tag
read and track start. Its return value was ignored too, so an invalid track
number dereferenced a null info. gme_open_file() and gme_start_track()
errors are now reported instead of continuing with a half-initialised
emulator.

Upstream: generic bug, suitable for xbmc/audiodecoder.gme.

--- a/src/GMECodec.cpp
+++ b/src/GMECodec.cpp
@@ -37,8 +37,7 @@
   if (track > 0)
     --track;
 
-  gme_open_file(toLoad.c_str(), &ctx.gme, 48000);
-  if (!ctx.gme)
+  if (gme_open_file(toLoad.c_str(), &ctx.gme, 48000) || !ctx.gme)
     return false;
 
   channels = 2;
@@ -46,11 +45,14 @@
   bitspersample = 16;
   bitrate = 0.0;
   format = AUDIOENGINE_FMT_S16NE;
-  gme_info_t* out;
-  gme_track_info(ctx.gme, &out, track);
+  gme_info_t* out = nullptr;
+  if (gme_track_info(ctx.gme, &out, track) || !out)
+    return false;
   totaltime = ctx.len = out->play_length;
+  gme_free_info(out);
   channellist = {AUDIOENGINE_CH_FL, AUDIOENGINE_CH_FR};
-  gme_start_track(ctx.gme, track);
+  if (gme_start_track(ctx.gme, track))
+    return false;
 
   return true;
 }
