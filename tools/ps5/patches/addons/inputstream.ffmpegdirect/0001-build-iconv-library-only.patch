Build and install only the libiconv library needed by FFmpeg Direct.

libiconv 1.19's utility support fails with an undefined gnulib
_GL_ATTRIBUTE_FORMAT_PRINTF_STANDARD macro. The add-on needs neither the
iconv executable nor its utility support library. The top-level install-lib
target depends on all, so install the library and public header directly,
preserving the localcharset header preparation and checking install errors.

Upstream: PS5-only; avoids building unused cross-compiled utilities.

--- a/depends/common/iconv/CMakeLists.txt
+++ b/depends/common/iconv/CMakeLists.txt
@@ -17,8 +17,18 @@
                       --enable-extra-encodings
                       --enable-static
                       --with-pic
-                    BUILD_COMMAND make
+                    BUILD_COMMAND make lib/localcharset.h
+                      COMMAND make -C lib
                     INSTALL_COMMAND ""
                     BUILD_IN_SOURCE 1)
 
-install(CODE "execute_process(COMMAND make install-lib WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})")
+install(CODE "
+  execute_process(COMMAND make -C lib install-lib
+                  WORKING_DIRECTORY \"${CMAKE_CURRENT_SOURCE_DIR}\"
+                  RESULT_VARIABLE install_result)
+  if(NOT install_result EQUAL 0)
+    message(FATAL_ERROR \"libiconv library install failed: \${install_result}\")
+  endif()
+  file(INSTALL \"${CMAKE_CURRENT_SOURCE_DIR}/include/iconv.h.inst\"
+       DESTINATION \"${OUTPUT_DIR}/include\" RENAME iconv.h)
+")
