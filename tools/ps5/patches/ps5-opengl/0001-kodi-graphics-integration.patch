diff --git a/src/egl/ps5_egl.c b/src/egl/ps5_egl.c
index 0e1284a..ea993b0 100644
--- a/src/egl/ps5_egl.c
+++ b/src/egl/ps5_egl.c
@@ -46,6 +46,11 @@ struct ps5_egl_display {
    struct pipe_resource *scanout[2];
 };
 
+/* KODI-PS5: EGL images over existing memory (zero-copy video) */
+static bool ps5_kodi_validate_egl_image(struct pipe_frontend_screen *fscreen, void *image);
+static bool ps5_kodi_get_egl_image(struct pipe_frontend_screen *fscreen, void *image,
+                                   struct st_egl_image *out);
+
 struct ps5_egl_config {
    struct st_visual visual;
 };
@@ -516,6 +521,8 @@ eglInitialize(EGLDisplay display, EGLint *major, EGLint *minor)
       ps5_display.frontend.screen = ps5_display.screen;
       ps5_display.frontend.get_param = ps5_frontend_get_param;
       ps5_display.frontend.set_background_context = ps5_background_context;
+      ps5_display.frontend.validate_egl_image = ps5_kodi_validate_egl_image; /* KODI-PS5 */
+      ps5_display.frontend.get_egl_image = ps5_kodi_get_egl_image;
       ps5_display.next_drawable_id = 1;
 
       struct pipe_resource resource;
@@ -1625,3 +1632,85 @@ eglSurfaceAttrib(EGLDisplay display, EGLSurface surface, EGLint attribute,
                  EGL_BAD_DISPLAY);
    return EGL_FALSE;
 }
+
+/* KODI-PS5: EGL images over existing memory, for Kodi's zero-copy video. The
+ * image handle is passed to glEGLImageTargetTexture2DOES; Mesa asks these
+ * hooks for the resource behind it. */
+#define PS5_KODI_IMAGE_MAGIC 0x4b4f4449u
+struct ps5_kodi_image {
+   uint32_t magic;
+   struct pipe_resource *resource;
+};
+struct pipe_resource *ps5_kodi_resource_from_memory(struct pipe_screen *screen,
+                                                    enum pipe_format format,
+                                                    unsigned width, unsigned height,
+                                                    unsigned stride, void *data);
+
+static bool
+ps5_kodi_validate_egl_image(struct pipe_frontend_screen *fscreen, void *image)
+{
+   const struct ps5_kodi_image *img = image;
+   return fscreen == &ps5_display.frontend && ps5_display.initialized &&
+          img && img->magic == PS5_KODI_IMAGE_MAGIC && img->resource &&
+          img->resource->screen == ps5_display.screen;
+}
+
+static bool
+ps5_kodi_get_egl_image(struct pipe_frontend_screen *fscreen, void *image,
+                       struct st_egl_image *out)
+{
+   if (!out || !ps5_kodi_validate_egl_image(fscreen, image))
+      return false;
+   const struct ps5_kodi_image *img = image;
+   memset(out, 0, sizeof(*out));
+   pipe_resource_reference(&out->texture, img->resource);
+   out->format = img->resource->format;
+   out->level = 0;
+   out->layer = 0;
+   return true;
+}
+
+/* components 1 or 2, bytes per component 1 or 2: R8, RG8, R16, RG16 */
+void *ps5_opengl_memory_image_create(void *data, unsigned width, unsigned height,
+                                     unsigned stride, unsigned components,
+                                     unsigned bytes_per_component);
+void *
+ps5_opengl_memory_image_create(void *data, unsigned width, unsigned height, unsigned stride,
+                               unsigned components, unsigned bytes_per_component)
+{
+   enum pipe_format format = PIPE_FORMAT_NONE;
+   if (components == 1 && bytes_per_component == 1)
+      format = PIPE_FORMAT_R8_UNORM;
+   else if (components == 2 && bytes_per_component == 1)
+      format = PIPE_FORMAT_R8G8_UNORM;
+   else if (components == 1 && bytes_per_component == 2)
+      format = PIPE_FORMAT_R16_UNORM;
+   else if (components == 2 && bytes_per_component == 2)
+      format = PIPE_FORMAT_R16G16_UNORM;
+   if (format == PIPE_FORMAT_NONE || !ps5_display.initialized || !ps5_display.screen)
+      return NULL;
+   struct pipe_resource *resource = ps5_kodi_resource_from_memory(
+      ps5_display.screen, format, width, height, stride, data);
+   if (!resource)
+      return NULL;
+   struct ps5_kodi_image *img = calloc(1, sizeof(*img));
+   if (!img) {
+      pipe_resource_reference(&resource, NULL);
+      return NULL;
+   }
+   img->magic = PS5_KODI_IMAGE_MAGIC;
+   img->resource = resource;
+   return img;
+}
+
+void ps5_opengl_memory_image_destroy(void *image);
+void
+ps5_opengl_memory_image_destroy(void *image)
+{
+   struct ps5_kodi_image *img = image;
+   if (!img || img->magic != PS5_KODI_IMAGE_MAGIC)
+      return;
+   img->magic = 0;
+   pipe_resource_reference(&img->resource, NULL);
+   free(img);
+}
diff --git a/src/gallium/ps5/ps5_screen.c b/src/gallium/ps5/ps5_screen.c
index e08cb9d..fc14fbb 100644
--- a/src/gallium/ps5/ps5_screen.c
+++ b/src/gallium/ps5/ps5_screen.c
@@ -599,6 +599,7 @@ struct ps5_resource {
    int64_t stencil_direct_start;
    unsigned render_arena_first_slot;
    unsigned render_arena_slot_count;
+   bool kodi_foreign_memory; /* KODI-PS5: memory owned by someone else (zero-copy video) */
 };
 
 struct ps5_transfer {
@@ -2695,6 +2696,10 @@ static void
 ps5_flush_texture_backing(struct ps5_batch_flush_cache *batch, unsigned slot,
                            struct ps5_resource *texture, size_t bytes, bool stencil)
 {
+   /* KODI-PS5: foreign memory is written by the video decoder, not the CPU:
+    * nothing to flush out of the CPU's caches. */
+   if (texture->kodi_foreign_memory)
+      return;
    uint64_t *epoch = stencil ? &texture->stencil_publication_epoch : &texture->texture_publication_epoch;
    size_t *published = stencil ? &texture->stencil_published_bytes : &texture->texture_published_bytes;
    const void *data = stencil ? texture->stencil_data : texture->data;
@@ -5842,6 +5847,11 @@ ps5_resource_destroy(struct pipe_screen *screen, struct pipe_resource *base)
       memset(ps5->render_arena_bitmap, 0,
              sizeof(ps5->render_arena_bitmap));
    }
+   if (resource->kodi_foreign_memory) { /* KODI-PS5: not ours to unmap */
+      resource->data = NULL;
+      resource->allocation_size = 0;
+      resource->direct_start = -1;
+   }
    simple_mtx_unlock(&ps5->resource_mutex);
    ps5_release_resource_memory(resource->stencil_data,
       resource->stencil_allocation_size, resource->stencil_direct_start);
@@ -18113,3 +18123,54 @@ ps5_screen_create(void)
    screen->base.nir_options[MESA_SHADER_COMPUTE] = cs_options;
    return &screen->base;
 }
+
+/* KODI-PS5: a sampler-only linear texture over decoder-owned GPU memory.
+ * Validate with the driver's layout rules, including format/dimension limits;
+ * never allocate, map or publish the decoder's backing store here. The caller
+ * keeps it alive until all image/texture references and GPU reads retire. */
+struct pipe_resource *ps5_kodi_resource_from_memory(struct pipe_screen *screen,
+                                                    enum pipe_format format,
+                                                    unsigned width, unsigned height,
+                                                    unsigned stride, void *data);
+struct pipe_resource *
+ps5_kodi_resource_from_memory(struct pipe_screen *screen, enum pipe_format format,
+                              unsigned width, unsigned height, unsigned stride, void *data)
+{
+   if (!screen || !data || !width || !height ||
+       width > PS5_MAX_TEXTURE_2D_SIZE || height > PS5_MAX_TEXTURE_2D_SIZE ||
+       height > UINT16_MAX || ((uintptr_t)data & 255u) || (uintptr_t)data >> 48 ||
+       (format != PIPE_FORMAT_R8_UNORM && format != PIPE_FORMAT_R8G8_UNORM &&
+        format != PIPE_FORMAT_R16_UNORM && format != PIPE_FORMAT_R16G16_UNORM))
+      return NULL;
+   struct pipe_resource templ = {0};
+   templ.target = PIPE_TEXTURE_2D;
+   templ.format = format;
+   templ.width0 = width;
+   templ.height0 = height;
+   templ.depth0 = 1;
+   templ.array_size = 1;
+   templ.bind = PIPE_BIND_SAMPLER_VIEW;
+   templ.usage = PIPE_USAGE_DEFAULT;
+   size_t size;
+   unsigned expected_stride;
+   if (!ps5_linear_sampled_layout(&templ) ||
+       !ps5_resource_layout(&templ, &size, &expected_stride) ||
+       stride != expected_stride || size != (size_t)stride * height ||
+       size > UINT64_C(0x1000000000000) - (uintptr_t)data)
+      return NULL;
+   struct ps5_resource *resource = calloc(1, sizeof(*resource));
+   if (!resource)
+      return NULL;
+   resource->base = templ;
+   resource->base.reference.count = 1;
+   resource->base.screen = screen;
+   resource->data = data;
+   resource->size = resource->allocation_size = size;
+   resource->stride = stride;
+   resource->level_stride[0] = stride;
+   resource->layer_stride = size;
+   resource->direct_start = -1;
+   resource->stencil_direct_start = -1;
+   resource->kodi_foreign_memory = true;
+   return &resource->base;
+}
diff --git a/src/platform/ps5_agc_native_runtime.c b/src/platform/ps5_agc_native_runtime.c
index c70c19f..d072456 100644
--- a/src/platform/ps5_agc_native_runtime.c
+++ b/src/platform/ps5_agc_native_runtime.c
@@ -930,9 +930,18 @@ static void flush_gpu_data(const void *address, size_t bytes);
 
 static video_api_t runtime_video_api;
 static int runtime_video_handle = -1;
+
+/* KODI-PS5: video out handle once presentation has opened it (-1 before). */
+int ps5_opengl_video_out_handle(void);
+int ps5_opengl_video_out_handle(void)
+{
+    return runtime_video_handle;
+}
 static uint8_t *runtime_video_framebuffer;
 static size_t runtime_video_framebuffer_size;
 static int runtime_video_registered;
+static uint64_t kodi_scanout_pixel_format = VIDEO_OUT_PIXEL_FORMAT;
+static uint32_t kodi_scanout_width, kodi_scanout_height;
 static uint64_t runtime_render_marker = (uint64_t)RENDER_MARKER;
 static unsigned runtime_present_count;
 static int runtime_agc_initialized;
@@ -2426,6 +2435,9 @@ static int runtime_video_acquire(const video_api_t *video,
     runtime_video_framebuffer = framebuffer;
     runtime_video_framebuffer_size = framebuffer_size;
     runtime_video_registered = 1;
+    kodi_scanout_pixel_format = VIDEO_OUT_PIXEL_FORMAT;
+    kodi_scanout_width = DISPLAY_WIDTH;
+    kodi_scanout_height = DISPLAY_HEIGHT;
     runtime_scanout_flush_needed = 1;
     printf("[ps5-agc] present-open handle=%08" PRIx32
            " framebuffer=%p/%zu buffers=2 alias=%u\n",
@@ -5509,3 +5521,54 @@ cleanup:
 #endif
     return result || work_unmap_rc || work_release_rc;
 }
+
+/* KODI-PS5: switch the scanout buffers' pixel format (HDR output) in place:
+ * sceVideoOutSubmitChangeBufferAttribute2 on buffer set 0, applied by
+ * VideoOut at the next flip - the call games use to toggle HDR. Deliberately
+ * no unregister/register fallback: the set on screen cannot be unregistered
+ * (RESOURCE_BUSY), the re-register then fails SLOT_OCCUPIED, and that sequence
+ * can leave the next present hanging (EVO Player, hardware 2026-09-28).
+ * results[0] = change result; results[1..3] unused (0x7fffffff).
+ * Returns 0 if the new format is in effect. */
+int ps5_opengl_set_scanout_format(uint64_t pixel_format, int32_t results[4]);
+#if defined(AGC_RUNTIME_PACKAGES) /* the runtime's video state lives in this build only */
+int sceVideoOutSubmitChangeBufferAttribute2(int32_t handle, int32_t set_index,
+                                            const void *attribute, int32_t category,
+                                            void *option);
+int
+ps5_opengl_set_scanout_format(uint64_t pixel_format, int32_t results[4])
+{
+    if (!results)
+        return -1;
+    for (int i = 0; i < 4; ++i)
+        results[i] = 0x7fffffff;
+    if (!runtime_video_registered || runtime_video_handle < 0 || !runtime_video_api.set_attribute2)
+        return -1;
+    if (pixel_format != VIDEO_OUT_PIXEL_FORMAT &&
+        pixel_format != UINT64_C(0x8100070422000000))
+        return -1;
+    if (!kodi_scanout_width || !kodi_scanout_height)
+        return -1;
+    if (pixel_format == kodi_scanout_pixel_format)
+        return 0;
+    video_attribute_t attribute = {{0}};
+    runtime_video_api.set_attribute2(&attribute, pixel_format, 0, kodi_scanout_width, kodi_scanout_height,
+                                     0, 0, 0);
+    results[0] = sceVideoOutSubmitChangeBufferAttribute2(runtime_video_handle, 0, &attribute, 0,
+                                                         NULL);
+    if (results[0] == 0)
+        kodi_scanout_pixel_format = pixel_format;
+    return results[0];
+}
+#else
+int
+ps5_opengl_set_scanout_format(uint64_t pixel_format, int32_t results[4])
+{
+    (void)pixel_format;
+    if (!results)
+        return -1;
+    for (int i = 0; i < 4; ++i)
+        results[i] = 0x7fffffff;
+    return -1;
+}
+#endif
