+bool TimeshiftSegment::FinishWrite()
+{
+  std::lock_guard<std::mutex> writeLock(m_writeMutex);
+  if (!m_fileHandle.IsOpen())
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_persisted;
+  }
+
+  bool persisted = FlushWriteBuffer();
+  if (persisted && m_fileHandle.Seek(0) != 0)
+  {
+    Log(LOGLEVEL_ERROR, "%s - Cannot seek segment header: %s; history retained in memory",
+        __FUNCTION__, CURL::GetRedacted(m_timeshiftSegmentFilePath).c_str());
+    persisted = false;
+  }
+  if (persisted)
+    persisted = WriteAll(&m_currentPacketIndex, sizeof(m_currentPacketIndex));
+  m_fileHandle.Close();
+  std::vector<uint8_t>().swap(m_writeBuffer);
+
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_persisted = persisted;
+  return persisted;
+}
