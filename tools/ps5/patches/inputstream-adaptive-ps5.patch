 void adaptive::AdaptiveStream::Dispose()
 {
+  // Publish exit before waking a worker waiting for segments.
+  if (thread_data_)
+    thread_data_->RequestExit();
+
+  LOG::PS5StopPhase("segment-reset-enter", this);
   m_segBuffers.Reset();
+  LOG::PS5StopPhase("segment-reset-exit", this);
 
   segment_read_pos_ = 0;
   absolute_position_ = 0;
 
   if (thread_data_)
   {
+    LOG::PS5StopPhase("thread-delete-enter", this);
     delete thread_data_;
     thread_data_ = nullptr;
+    LOG::PS5StopPhase("thread-delete-exit", this);
   }
 }
 
