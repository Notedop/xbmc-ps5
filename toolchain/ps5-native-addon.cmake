# SPDX-License-Identifier: GPL-3.0-or-later
# Use with cmake/addons and a prepared PS5_NATIVE_RUNTIME_SDK, not the title toolchain.
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CORE_SYSTEM_NAME freebsd CACHE STRING "")
set(CORE_PLATFORM_NAME ps5 CACHE STRING "")
set(PS5_NATIVE_SHARED_ADDONS ON CACHE BOOL "Build add-ons against a prepared native runtime SDK")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
if(NOT PS5_PAYLOAD_SDK)
  if(DEFINED ENV{PS5_PAYLOAD_SDK})
    set(PS5_PAYLOAD_SDK "$ENV{PS5_PAYLOAD_SDK}" CACHE PATH "")
  else()
    set(PS5_PAYLOAD_SDK "/opt/ps5-payload-sdk" CACHE PATH "")
  endif()
endif()
set(CMAKE_C_COMPILER "${PS5_PAYLOAD_SDK}/bin/prospero-clang")
set(CMAKE_CXX_COMPILER "${PS5_PAYLOAD_SDK}/bin/prospero-clang++")
find_program(PS5_NATIVE_PYTHON NAMES python3 REQUIRED NO_CMAKE_FIND_ROOT_PATH)
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../PS5NativeABI.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/../PS5NativeABI.cmake")
  set(PS5_NATIVE_ABI_HEADER "${CMAKE_CURRENT_LIST_DIR}/../include/ps5_native_abi.h")
  set(PS5_NATIVE_COMPILER_LAUNCHER "${CMAKE_CURRENT_LIST_DIR}/../tools/native-clang.py")
else()
  include("${CMAKE_CURRENT_LIST_DIR}/../cmake/scripts/ps5/PS5NativeABI.cmake")
  set(PS5_NATIVE_ABI_HEADER "${CMAKE_CURRENT_LIST_DIR}/../tools/ps5/native_abi_check.h")
  set(PS5_NATIVE_COMPILER_LAUNCHER "${CMAKE_CURRENT_LIST_DIR}/../tools/ps5/native-clang.py")
endif()
set(CMAKE_C_COMPILER_LAUNCHER "${PS5_NATIVE_PYTHON};${PS5_NATIVE_COMPILER_LAUNCHER}")
set(CMAKE_CXX_COMPILER_LAUNCHER "${PS5_NATIVE_PYTHON};${PS5_NATIVE_COMPILER_LAUNCHER}")
string(JOIN " " PS5_NATIVE_ABI_FLAGS ${PS5_NATIVE_ABI_COMPILE_OPTIONS})
set(CMAKE_C_FLAGS_INIT "${PS5_NATIVE_ABI_FLAGS} -include \"${PS5_NATIVE_ABI_HEADER}\"")
set(CMAKE_CXX_FLAGS_INIT "${PS5_NATIVE_ABI_FLAGS} -include \"${PS5_NATIVE_ABI_HEADER}\"")
if(PS5_NATIVE_RUNTIME_SDK)
  string(APPEND CMAKE_C_FLAGS_INIT " -I\"${PS5_NATIVE_RUNTIME_SDK}/include\"")
  string(APPEND CMAKE_CXX_FLAGS_INIT
    " -nostdinc++ -I\"${PS5_PAYLOAD_SDK}/target/include/c++/v1\" -I\"${PS5_NATIVE_RUNTIME_SDK}/include\"")
endif()
set(CMAKE_SYSROOT "${PS5_PAYLOAD_SDK}")
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_FIND_ROOT_PATH "${PS5_PAYLOAD_SDK}/target/user/homebrew")
foreach(_ps5_dependency_root IN ITEMS "${ADDON_DEPENDS_PATH}" "${OUTPUT_DIR}")
  if(_ps5_dependency_root)
    list(PREPEND CMAKE_FIND_ROOT_PATH "${_ps5_dependency_root}")
  endif()
endforeach()
list(REMOVE_DUPLICATES CMAKE_FIND_ROOT_PATH)
unset(_ps5_dependency_root)
if(NOT PS5_OPENGL_PREFIX)
  set(PS5_OPENGL_PREFIX "$ENV{PS5_OPENGL_PREFIX}" CACHE PATH "")
endif()
if(PS5_OPENGL_PREFIX)
  list(APPEND CMAKE_FIND_ROOT_PATH "${PS5_OPENGL_PREFIX}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
     PS5_PAYLOAD_SDK PS5_OPENGL_PREFIX ADDON_DEPENDS_PATH OUTPUT_DIR
     PS5_NATIVE_RUNTIME_SDK PS5_NATIVE_DEPENDS_MAP PS5_DEPENDS_PREFIX)
