+int FFmpegStream::OpenWithKodiTrust(AVFormatContext* context, AVIOContext** io,
+                                   const char* url, int flags, AVDictionary** options)
+{
+  auto* stream = static_cast<FFmpegStream*>(context->opaque);
+  const std::string caFile =
+      kodi::vfs::TranslateSpecialProtocol("special://xbmc/system/certs/cacert.pem");
+  int result = av_dict_set(options, "ca_file", caFile.c_str(), 0);
+  if (result < 0)
+    return result;
+
+  result = av_dict_set(options, "tls_verify", "1", 0);
+  if (result < 0)
+    return result;
+
+  return stream->m_defaultIOOpen(context, io, url, flags, options);
+}
+
 bool FFmpegStream::OpenWithFFmpeg(const AVInputFormat* iformat, const AVIOInterruptCB& int_cb)
 {
   Log(LOGLEVEL_INFO, "%s - IO handled by FFmpeg's AVFormat", __FUNCTION__);
@@ -955,6 +975,8 @@
