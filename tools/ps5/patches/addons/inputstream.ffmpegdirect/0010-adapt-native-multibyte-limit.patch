Bridge libiconv's FreeBSD multibyte-limit accessor to native libc data.

The SDK stdlib header declares ___mb_cur_max(), but native libc exports
the __mb_cur_max integer instead. Read the native value rather than
assuming a fixed locale or changing libiconv's wchar conversion behavior.
Keep this adapter local to the add-on; no runtime provider change is needed.

Upstream: PS5 native libc ABI adaptation only.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -112,6 +112,13 @@
 
 build_addon(inputstream.ffmpegdirect FFMPEGDIRECT DEPLIBS)
 
+if(PS5_NATIVE_SHARED_ADDONS)
+  set(_multibyte_adapter "${CMAKE_CURRENT_BINARY_DIR}/ps5-multibyte-limit.c")
+  file(WRITE "${_multibyte_adapter}"
+    "#include <stdlib.h>\nint ___mb_cur_max(void) { return __mb_cur_max; }\n")
+  target_sources(inputstream.ffmpegdirect PRIVATE "${_multibyte_adapter}")
+endif()
+
 if(${CMAKE_SYSTEM_NAME} MATCHES "Darwin")
   # Due to a bug in CMake and frameworks on OSX we strip them from FFMPEG_LDFLAGS
   string(REGEX REPLACE "-framework;([A-Za-z0-9_]+);?" "" FFMPEG_LDFLAGS "${FFMPEG_LDFLAGS}")
