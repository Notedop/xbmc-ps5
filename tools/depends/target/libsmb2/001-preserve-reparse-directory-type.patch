Directories can also carry FILE_ATTRIBUTE_REPARSE_POINT (including cloud-backed
directories). Preserve their directory type for listing, stat and fstat, without
changing the public stat layout or turning non-directory reparse points into
directories.

diff --git a/lib/smb2-file-type.h b/lib/smb2-file-type.h
new file mode 100644
--- /dev/null
+++ b/lib/smb2-file-type.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#ifndef LIBSMB2_FILE_TYPE_H
+#define LIBSMB2_FILE_TYPE_H
+
+#include <stdint.h>
+
+static inline uint32_t smb2_type_from_attributes(uint32_t attributes)
+{
+        /* A reparse point is not necessarily a non-directory symbolic link. */
+        if (attributes & SMB2_FILE_ATTRIBUTE_DIRECTORY)
+                return SMB2_TYPE_DIRECTORY;
+        if (attributes & SMB2_FILE_ATTRIBUTE_REPARSE_POINT)
+                return SMB2_TYPE_LINK;
+        return SMB2_TYPE_FILE;
+}
+
+#endif
