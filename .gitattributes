# Normalize text files to LF
* text=auto

# Force LF for source and configuration files
*.c       text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
*.hpp     text eol=lf
*.cmake   text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.xml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
CMakeLists.txt text eol=lf