+bool TimeshiftSegment::WriteAll(const void* data, size_t size)
+{
+  const auto* bytes = static_cast<const uint8_t*>(data);
+  while (size > 0)
+  {
+    const ssize_t written = m_fileHandle.Write(bytes, size);
+    if (written <= 0 || static_cast<size_t>(written) > size)
+    {
+      Log(LOGLEVEL_ERROR, "%s - Segment write failed: %s, requested: %llu, returned: %lld; history retained in memory",
+          __FUNCTION__, CURL::GetRedacted(m_timeshiftSegmentFilePath).c_str(),
+          static_cast<unsigned long long>(size), static_cast<long long>(written));
+      m_persistSegments = false;
+      return false;
+    }
+    bytes += written;
+    size -= written;
+  }
+  return true;
+}
+
+bool TimeshiftSegment::FlushWriteBuffer()
+{
+  const bool result = m_persistSegments &&
+      WriteAll(m_writeBuffer.data(), m_writeBuffer.size());
+  m_writeBuffer.clear();
+  return result;
+}
+
+void TimeshiftSegment::AppendWriteBuffer(const void* data, size_t size)
+{
+  if (!m_persistSegments)
+    return;
+  const auto* bytes = static_cast<const uint8_t*>(data);
+  while (size > 0)
+  {
+    const size_t count = std::min(size, WRITE_BUFFER_SIZE - m_writeBuffer.size());
+    m_writeBuffer.insert(m_writeBuffer.end(), bytes, bytes + count);
+    bytes += count;
+    size -= count;
+    if (m_writeBuffer.size() == WRITE_BUFFER_SIZE && !FlushWriteBuffer())
+      return;
+  }
+}
