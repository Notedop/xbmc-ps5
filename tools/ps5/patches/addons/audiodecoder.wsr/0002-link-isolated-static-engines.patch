+++ b/lib/in_wsr/CMakeLists.txt
@@ -10,3 +10,22 @@
-add_library(in_wsr_0 SHARED ${SOURCES})
-add_library(in_wsr_1 SHARED ${SOURCES})
-add_library(in_wsr_track SHARED ${SOURCES})
+set(WSR_GLOBALS
+    CPU_Count CPU_Cycles CPU_Run ChannelMuting Close_SampleData Close_WSR
+    DMACycles Get_ChannelMuting Get_FirstSong Init_SampleData Init_WSR
+    Load_WSR ROM ROMBank ROMSize Reset_WSR SampleRate Sample_Enable
+    Sample_Length Sample_Offset Set_ChannelMuting Set_Frequency
+    Update_SampleData Update_WSR WSRPlayerSetUp WS_Cpu_Clock WaveAdrs baseBank
+    cpu_interrupt cpu_readmem20 cpu_readport cpu_writemem20 cpu_writeport
+    initialIoValue mul_div nec_Cycles nec_ICount nec_execute nec_exit
+    nec_get_reg nec_getcycles nec_instruction nec_int nec_reset nec_set_reg
+    nec_yield romAddressMask romSize sample_buffer seg_prefix ws_audio_done
+    ws_audio_init ws_audio_port_read ws_audio_port_write ws_audio_process
+    ws_audio_reset ws_audio_sounddma ws_audio_update ws_internalRam ws_ioRam
+    ws_io_done ws_io_init ws_io_reset ws_memory_done ws_memory_init
+    ws_memory_reset ws_rom ws_staticRam ws_timer ws_timer_count ws_timer_min
+    ws_timer_pending ws_timer_reset ws_timer_set ws_timer_update)
+
+foreach(engine IN ITEMS in_wsr_track in_wsr_0 in_wsr_1)
+  add_library(${engine} STATIC ${SOURCES})
+  foreach(symbol IN LISTS WSR_GLOBALS)
+    target_compile_definitions(${engine} PRIVATE "${symbol}=${engine}_${symbol}")
+  endforeach()
+endforeach()
