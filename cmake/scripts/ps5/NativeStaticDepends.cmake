# Keep private dependency rebuilds out of the installed SDK and static baseline.
include_guard(GLOBAL)

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/tools/native_static_depends.py")
  set(_ps5_map_validator "${CMAKE_CURRENT_LIST_DIR}/tools/native_static_depends.py")
else()
  set(_ps5_map_validator "${CMAKE_CURRENT_LIST_DIR}/../../../tools/ps5/native_static_depends.py")
endif()
execute_process(
  COMMAND "${PS5_NATIVE_PYTHON}" "${_ps5_map_validator}"
          --map "${PS5_NATIVE_DEPENDS_MAP}"
          --stdio-header "${PS5_NATIVE_RUNTIME_SDK}/include/stdio.h"
  RESULT_VARIABLE _ps5_archive_result OUTPUT_VARIABLE _ps5_archive_map
  ERROR_VARIABLE _ps5_archive_error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _ps5_archive_result EQUAL 0)
  message(FATAL_ERROR "Invalid native dependency replacements: ${_ps5_archive_error}")
endif()
set_property(GLOBAL PROPERTY PS5_NATIVE_ARCHIVE_MAP "${_ps5_archive_map}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PS5_NATIVE_DEPENDS_MAP}")

function(ps5_native_archive original result)
  get_property(_map GLOBAL PROPERTY PS5_NATIVE_ARCHIVE_MAP)
  string(JSON _replacement ERROR_VARIABLE _missing GET "${_map}" "${original}")
  if(_missing)
    set(${result} "${original}" PARENT_SCOPE)
  else()
    set(${result} "${_replacement}" PARENT_SCOPE)
  endif()
endfunction()

function(ps5_native_archive_targets directory)
  get_property(_map GLOBAL PROPERTY PS5_NATIVE_ARCHIVE_MAP)
  string(JSON _count LENGTH "${_map}")
  math(EXPR _last "${_count} - 1")
  get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(_imports DIRECTORY "${directory}" PROPERTY IMPORTED_TARGETS)
  foreach(_target IN LISTS _targets _imports)
    if(NOT TARGET "${_target}")
      continue()
    endif()
    get_target_property(_alias "${_target}" ALIASED_TARGET)
    if(_alias)
      continue()
    endif()
    set(_properties LINK_LIBRARIES INTERFACE_LINK_LIBRARIES
        IMPORTED_LOCATION IMPORTED_IMPLIB IMPORTED_LINK_INTERFACE_LIBRARIES)
    get_target_property(_configurations "${_target}" IMPORTED_CONFIGURATIONS)
    if(NOT _configurations)
      set(_configurations "")
    endif()
    list(APPEND _configurations RELEASE DEBUG RELWITHDEBINFO MINSIZEREL NOCONFIG)
    foreach(_configuration IN LISTS _configurations)
      string(TOUPPER "${_configuration}" _configuration)
      list(APPEND _properties "IMPORTED_LOCATION_${_configuration}"
           "IMPORTED_IMPLIB_${_configuration}" "IMPORTED_LINK_INTERFACE_LIBRARIES_${_configuration}")
    endforeach()
    foreach(_property IN LISTS _properties)
      get_target_property(_value "${_target}" "${_property}")
      if(NOT _value OR _value MATCHES "-NOTFOUND$")
        continue()
      endif()
      set(_updated "${_value}")
      foreach(_index RANGE 0 ${_last})
        string(JSON _original MEMBER "${_map}" ${_index})
        string(JSON _replacement GET "${_map}" "${_original}")
        string(REPLACE "${_original}" "${_replacement}" _updated "${_updated}")
        get_filename_component(_name "${_original}" NAME_WE)
        string(REGEX REPLACE "^lib" "" _name "${_name}")
        list(TRANSFORM _updated REPLACE "^-l${_name}$" "${_replacement}")
        string(REPLACE "$<LINK_ONLY:-l${_name}>" "$<LINK_ONLY:${_replacement}>"
               _updated "${_updated}")
      endforeach()
      if(NOT _updated STREQUAL _value)
        set_property(TARGET "${_target}" PROPERTY "${_property}" "${_updated}")
      endif()
    endforeach()
  endforeach()
  get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(_child IN LISTS _children)
    ps5_native_archive_targets("${_child}")
  endforeach()
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}"
               CALL ps5_native_archive_targets "${CMAKE_SOURCE_DIR}")
