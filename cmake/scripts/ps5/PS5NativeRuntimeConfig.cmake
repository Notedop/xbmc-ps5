include_guard(GLOBAL)
if(CMAKE_VERSION VERSION_LESS 3.19)
  message(FATAL_ERROR "PS5 native shared add-ons require CMake 3.19 or newer")
endif()

if(NOT PS5_NATIVE_RUNTIME_SDK)
  set(PS5_NATIVE_RUNTIME_SDK "${CMAKE_CURRENT_LIST_DIR}")
endif()
get_filename_component(PS5_NATIVE_RUNTIME_SDK "${PS5_NATIVE_RUNTIME_SDK}" ABSOLUTE)
find_program(PS5_NATIVE_PYTHON NAMES python3 REQUIRED NO_CMAKE_FIND_ROOT_PATH)
set(PS5_NATIVE_ADDON_BUILDER "${PS5_NATIVE_RUNTIME_SDK}/tools/build-native-shared-addon.py")
execute_process(COMMAND "${PS5_NATIVE_PYTHON}" "${PS5_NATIVE_ADDON_BUILDER}"
                        --sdk "${PS5_NATIVE_RUNTIME_SDK}" --describe
                RESULT_VARIABLE result OUTPUT_VARIABLE sdk ERROR_VARIABLE error
                OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Invalid prepared PS5 native runtime SDK: ${error}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
             "${PS5_NATIVE_RUNTIME_SDK}/manifest.json")
if(NOT APP_NAME_LC)
  set(APP_NAME_LC kodi)
endif()
if(NOT PS5_PAYLOAD_SDK)
  set(PS5_PAYLOAD_SDK "$ENV{PS5_PAYLOAD_SDK}")
endif()
if(NOT EXISTS "${PS5_PAYLOAD_SDK}/target/include/c++/v1/__config")
  message(FATAL_ERROR "PS5_PAYLOAD_SDK must name the payload SDK with libc++ headers")
endif()
include("${PS5_NATIVE_RUNTIME_SDK}/PS5NativeABI.cmake")
set(PS5_NATIVE_ABI_HEADER "${PS5_NATIVE_RUNTIME_SDK}/include/ps5_native_abi.h")
if(NOT EXISTS "${PS5_NATIVE_ABI_HEADER}")
  message(FATAL_ERROR "Prepared PS5 SDK is missing the compiler ABI guard header")
endif()
set(PS5_NATIVE_COMPILER_LAUNCHER "${PS5_NATIVE_RUNTIME_SDK}/tools/native-clang.py")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
             "${PS5_NATIVE_COMPILER_LAUNCHER}")
file(SHA256 "${PS5_NATIVE_COMPILER_LAUNCHER}" PS5_NATIVE_COMPILER_LAUNCHER_SHA256)
# A changed launcher must invalidate source objects, not just the final conversion.
add_compile_definitions(
  "PS5_NATIVE_COMPILER_LAUNCHER_SHA256=\"${PS5_NATIVE_COMPILER_LAUNCHER_SHA256}\"")
set(CMAKE_C_COMPILER_LAUNCHER "${PS5_NATIVE_PYTHON};${PS5_NATIVE_COMPILER_LAUNCHER}")
set(CMAKE_CXX_COMPILER_LAUNCHER "${PS5_NATIVE_PYTHON};${PS5_NATIVE_COMPILER_LAUNCHER}")

add_library(${APP_NAME_LC}::PS5NativeABI INTERFACE IMPORTED GLOBAL)
set_property(TARGET ${APP_NAME_LC}::PS5NativeABI PROPERTY INTERFACE_COMPILE_OPTIONS
  "${PS5_NATIVE_ABI_COMPILE_OPTIONS};SHELL:-include \"${PS5_NATIVE_ABI_HEADER}\";$<$<COMPILE_LANGUAGE:CXX>:-nostdinc++>;$<$<COMPILE_LANGUAGE:CXX>:-I${PS5_PAYLOAD_SDK}/target/include/c++/v1>;-I${PS5_NATIVE_RUNTIME_SDK}/include;-isystem;${PS5_PAYLOAD_SDK}/target/include")
string(JSON wrap_count LENGTH "${sdk}" wrap_symbols)
math(EXPR wrap_last "${wrap_count} - 1")
foreach(index RANGE 0 ${wrap_last})
  string(JSON symbol GET "${sdk}" wrap_symbols ${index})
  set_property(TARGET ${APP_NAME_LC}::PS5NativeABI APPEND PROPERTY
               INTERFACE_LINK_OPTIONS "LINKER:--wrap=${symbol}")
endforeach()

set(PS5_NATIVE_PROVIDER_LIBRARIES)
set(PS5_NATIVE_PROVIDER_MANIFESTS)
string(JSON count LENGTH "${sdk}" providers)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
  string(JSON module GET "${sdk}" providers ${index} module)
  string(JSON library GET "${sdk}" providers ${index} library)
  string(JSON manifest GET "${sdk}" providers ${index} manifest)
  if(module STREQUAL "libkodi-runtime")
    set(name PS5Runtime)
  elseif(module STREQUAL "libkodi-gl")
    set(name OpenGl)
  else()
    set(name "PS5_${module}")
  endif()
  add_library(${APP_NAME_LC}::${name} SHARED IMPORTED GLOBAL)
  set_target_properties(${APP_NAME_LC}::${name} PROPERTIES
    IMPORTED_LOCATION "${library}" IMPORTED_NO_SONAME FALSE
    INTERFACE_LINK_LIBRARIES "${APP_NAME_LC}::PS5NativeABI")
  list(APPEND PS5_NATIVE_PROVIDER_LIBRARIES "${APP_NAME_LC}::${name}")
  list(APPEND PS5_NATIVE_PROVIDER_MANIFESTS "${manifest}" "${library}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
endforeach()
if(NOT TARGET ${APP_NAME_LC}::PS5Runtime OR NOT TARGET ${APP_NAME_LC}::OpenGl)
  message(FATAL_ERROR "Prepared SDK requires libkodi-runtime and libkodi-gl providers")
endif()
find_path(OPENGL_INCLUDE_DIR NAMES GL/gl.h)
if(NOT OPENGL_INCLUDE_DIR)
  message(FATAL_ERROR "PS5 native shared add-ons require OpenGL headers")
endif()
set_property(TARGET ${APP_NAME_LC}::OpenGl PROPERTY
             INTERFACE_INCLUDE_DIRECTORIES "${OPENGL_INCLUDE_DIR}")
set_property(TARGET ${APP_NAME_LC}::OpenGl PROPERTY INTERFACE_COMPILE_DEFINITIONS HAS_GL=1)
set(OPENGL_gl_LIBRARY ${APP_NAME_LC}::OpenGl)
set(OPENGL_LIBRARIES ${APP_NAME_LC}::OpenGl)
set(OPENGL_INCLUDE_DIRS "${OPENGL_INCLUDE_DIR}")
set(OPENGL_DEFINITIONS -DHAS_GL=1)
set(OPENGL_FOUND TRUE)
set(PS5_NATIVE_SHARED_ADDONS TRUE)
include("${PS5_NATIVE_RUNTIME_SDK}/NativeSharedAddon.cmake")
if(PS5_NATIVE_DEPENDS_MAP)
  include("${PS5_NATIVE_RUNTIME_SDK}/NativeStaticDepends.cmake")
endif()
