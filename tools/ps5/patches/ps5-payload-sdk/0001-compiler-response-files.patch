diff --git a/host/bin/ps5-wrapper-args.py b/host/bin/ps5-wrapper-args.py
new file mode 100755
index 0000000..86381d2
--- /dev/null
+++ b/host/bin/ps5-wrapper-args.py
@@ -0,0 +1,36 @@
+#!/usr/bin/env python3
+"""Inspect GNU-style response files without changing arguments sent to Clang."""
+import pathlib
+import shlex
+import sys
+
+FLAGS = {
+    '-c', '-E', '-S', '-fsyntax-only', '-M', '-MM',
+    '-nostdlib', '-nostdlibc', '-nostdlib++', '-nodefaultlibs',
+    '-nostartfiles', '-shared', '-lkernel', '-lkernel_sys', '-lkernel_web',
+}
+
+
+def expand(arguments, stack=()):
+    for argument in arguments:
+        if argument.startswith('@'):
+            path = pathlib.Path(argument[1:]).resolve()
+            if path in stack or len(stack) >= 32:
+                raise ValueError(f'recursive response file: {path}')
+            lexer = shlex.shlex(path.read_text(), posix=True)
+            lexer.whitespace_split = True
+            lexer.commenters = ''
+            yield from expand(list(lexer), (*stack, path))
+        else:
+            yield argument
+
+
+try:
+    for argument in expand(sys.argv[1:]):
+        if argument in FLAGS:
+            print(argument)
+        elif argument and not argument.startswith('-'):
+            print('__PS5_WRAPPER_INPUT__')
+except (OSError, ValueError) as error:
+    print(f'PS5 compiler wrapper: {error}', file=sys.stderr)
+    sys.exit(1)
